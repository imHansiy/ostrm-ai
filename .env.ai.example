# Copy to .env. Generate independent secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
AI_BRIDGE_KEY=
OSTRM_PORT=3111
OPENLIST_URL=http://host.docker.internal:5244
PUBLIC_OPENLIST_URL=https://your-openlist.example.com
OPENLIST_USERNAME=admin
OPENLIST_PASSWORD=
OPENLIST_TOKEN=
# Background reads retry transient errors twice; interactive catalog probes retain short deadlines.
OPENLIST_SCAN_TIMEOUT=60
MODEL_BASE_URL=https://api.modelbest.ai/v1
MODEL_NAME=MiniCPM-V-4.7-35B-A3B
MODEL_API_KEY=
MODEL_PROXY_URL=
MEDIA_ALLOWED_HOSTS=*.sharepoint.com,*.1drv.com
MEDIA_PUBLIC_BASE_URL=https://your-media.example.com
# Opt in only after configuring AI scan roots and resource limits.
AI_AUTO_ENQUEUE=false
AI_DATA_PATH_HOST=./data/ai
STRM_PATH_HOST=./strm
CONFIG_PATH_HOST=./data/config
DB_PATH_HOST=./data/db
LOG_PATH_HOST=./logs
# Optional TiDB database; use a separate schema from OpenList itself.
AI_DB_BACKEND=sqlite
AI_TIDB_HOST=
AI_TIDB_PORT=4000
AI_TIDB_USER=
AI_TIDB_PASSWORD=
AI_TIDB_DATABASE=openlist_ai
# Bounded metadata exports, intermediate media files and compressed evidence cache.
MEDIA_EXPORT_MAX_BYTES=268435456
VIDEO_WORK_MAX_BYTES=536870912
EVIDENCE_CACHE_MAX_BYTES=67108864
EVIDENCE_CACHE_TTL=86400
