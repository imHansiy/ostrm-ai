# Copy ai-service/.env.example first, then add these server-only settings.
# Generate each secret independently: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
AI_BRIDGE_KEY=
NATIVE_APP_PREFIX=/ostrm/
NATIVE_GATEWAY_PORT=43647
NATIVE_JAVA_PORT=43648
NATIVE_AI_PORT=43649
# On hosts limited to three reserved ports, Java and AI can use the same
# reserved number on separate configured loopback addresses:
# NATIVE_AI_HOST=127.0.0.2
# NATIVE_AI_PORT=43648
AI_BACKGROUND_ENABLED=true
AI_PROXY_ENABLED=false
# OPENLIST_URL should point directly to the existing local OpenList origin.
# OPENLIST_URL=http://127.0.0.1:5244
# MEDIA_PUBLIC_BASE_URL=https://your-public-domain
