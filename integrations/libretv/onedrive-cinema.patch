+import { getEnvSources } from './env-sources';
+import { parseDetail,parseSearchList } from './cms-parser';
+import { cmsUrl } from './app-path';
+import type { SearchResultItem,VideoDetail } from './types';
+
+export interface LibraryItem extends SearchResultItem { summary:string; tags:string[]; category:string }
+export interface LibraryPage {
+  items:LibraryItem[];total:number;page:number;pages:number;pageSize:number;
+  categories:{id:string;name:string}[];years:string[];content:'general'|'adult';
+}
+interface Snapshot {items:LibraryItem[];categories:LibraryPage['categories'];years:string[];details?:Map<string,VideoDetail>}
+type Entry={value:Snapshot;expires:number};
+// Next compiles API routes separately. Share the same bounded cache so the
+// original detail endpoint can reuse metadata already obtained from the source.
+const shared=globalThis as typeof globalThis & {__libretvLibrary?:{cache:Map<string,Entry>;pending:Map<string,Promise<Snapshot>>}};
+const {cache,pending}=shared.__libretvLibrary??= {cache:new Map(),pending:new Map()};
+const collator=new Intl.Collator('zh-CN',{numeric:true,sensitivity:'base'});
+const clean=(value:unknown)=>String(value??'').replace(/<[^>]*>/g,'').trim();
+const validYear=(value:unknown)=>{const year=String(value??'');return /^\d{4}$/.test(year)&&Number(year)>=1878&&Number(year)<=new Date().getUTCFullYear()+2?year:'';};
+
+export function cachedLibraryDetail(url:string,id:string):VideoDetail|undefined {
+  const source=getEnvSources().find(s=>s.url===url);if(!source)return;
+  const entry=cache.get(JSON.stringify([source.url,source.isAdult]));
+  if(entry&&Date.now()-entry.expires<240000)return entry.value.details?.get(id);
+}
+
+export function libraryQuery(params:URLSearchParams) {
+  const n=Number(params.get('page')||1);
+  const sort=params.get('sort')||'newest';
+  return {content:params.get('content')==='adult'?'adult':'general',
+    page:Number.isSafeInteger(n)&&n>0?Math.min(n,100000):1,
+    q:(params.get('q')||'').trim().slice(0,100),category:(params.get('category')||'').slice(0,50),
+    year:/^(\d{4}|unknown)$/.test(params.get('year')||'')?params.get('year')!:'',
+    sort:['newest','oldest','name','year'].includes(sort)?sort:'newest'} as const;
+}
+
+// A compact, bounded snapshot supports global sorting and year/tag filtering even
+// when a MacCMS provider only supports pg/wd/t. Never download video files here.
+async function snapshot(source:ReturnType<typeof getEnvSources>[number]):Promise<Snapshot> {
+  const key=JSON.stringify([source.url,source.isAdult]);
+  const load=()=>{
+    const active=pending.get(key);if(active)return active;
+    const task=(async()=>{
+      const signal=AbortSignal.timeout(45000);
+      const fetchPage=async(page:number)=>{
+        const response=await fetch(cmsUrl(source.url,{ac:'videolist',pg:page,limit:100}),{signal,cache:'no-store'});
+        if(!response.ok)throw new Error('媒体源暂时无法访问');
+        const data=await response.json();
+        if(data.code!==1||!Array.isArray(data.list))throw new Error('媒体源返回了无效数据');
+        return data;
+      };
+      const first=await fetchPage(1),count=Number(first.pagecount)||1;
+      if(!Number.isSafeInteger(count)||count<1||count>100)throw new Error('媒体源目录超出单源 100 页上限，请缩小发布范围');
+      const pages=[first];let next=2;
+      // Two workers and a shared deadline bound network/CPU usage on small hosts.
+      await Promise.all(Array.from({length:Math.min(2,count-1)},async()=>{
+        while(next<=count){const page=next++;pages[page-1]=await fetchPage(page);}
+      }));
+      const seen=new Set<string>();const items:LibraryItem[]=[],details=new Map<string,VideoDetail>();
+      for(const data of pages){
+        const parsed=parseSearchList(data,source);
+        parsed.forEach((item,i)=>{
+          if(!item.vodId||seen.has(item.vodId))return;seen.add(item.vodId);
+          const raw=data.list[i];
+          try{const detail=parseDetail({list:[raw]},source);if(detail.episodes.length)details.set(item.vodId,detail);}catch{/* Original detail lookup remains the fallback. */}
+          items.push({...item,year:validYear(item.year),summary:clean(raw.vod_content),category:String(raw.type_id??''),
+            tags:clean(raw.vod_tag||raw.vod_class).split(/[,，、]/).filter(Boolean).slice(0,24)});
+        });
+      }
+      const value:Snapshot={items,details,categories:Array.isArray(first.class)?first.class.map((c:Record<string,unknown>)=>({id:String(c.type_id),name:clean(c.type_name)})):[],
+        years:[...new Set(items.map(i=>i.year||'').filter(y=>/^\d{4}$/.test(y)&&y!=='0000'))].sort().reverse()};
+      if(cache.size>=4&&!cache.has(key))cache.delete(cache.keys().next().value!);
+      cache.set(key,{value,expires:Date.now()+60000});return value;
+    })();
+    pending.set(key,task);task.finally(()=>pending.delete(key)).catch(()=>{});return task;
+  };
+  const cached=cache.get(key);
+  if(cached){
+    if(cached.expires>Date.now())return cached.value;
+    // Serve a recently expired snapshot while refreshing; never keep failures indefinitely.
+    if(Date.now()-cached.expires<240000){void load().catch(()=>{});return cached.value;}
+  }
+  return load();
+}
+
+export function selectLibrary(data:Snapshot,params:URLSearchParams):LibraryPage {
+  const query=libraryQuery(params),words=query.q.toLocaleLowerCase().split(/\s+/).filter(Boolean);
+  let items=data.items.filter(item=>(!query.category||item.category===query.category)&&
+    (!query.year||(query.year==='unknown'?!/^\d{4}$/.test(item.year||''):item.year===query.year))&&
+    words.every(word=>[item.name,item.summary,...item.tags].join(' ').toLocaleLowerCase().includes(word)));
+  if(query.sort==='oldest')items=items.reverse();
+  if(query.sort==='name')items.sort((a,b)=>collator.compare(a.name,b.name));
+  if(query.sort==='year')items.sort((a,b)=>Number(b.year||0)-Number(a.year||0));
+  const pageSize=24,total=items.length,pages=Math.max(1,Math.ceil(total/pageSize)),page=Math.min(query.page,pages);
+  return {content:query.content,page,pages,pageSize,total,categories:data.categories,years:data.years,
+    items:items.slice((page-1)*pageSize,page*pageSize)};
+}
+
+export async function readLibrary(params:URLSearchParams):Promise<LibraryPage> {
+  const {content}=libraryQuery(params);
+  const source=getEnvSources().find(s=>Boolean(s.isAdult)===(content==='adult'));
+  if(!source)throw new Error('尚未配置此内容源');
+  return selectLibrary(await snapshot(source),params);
+}
