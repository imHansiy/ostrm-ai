+/** Our media resolver returns an original file, rather than an HLS manifest. */
+export function isDirectMediaUrl(value:string):boolean {
+  try {
+    const path=decodeURIComponent(new URL(value,'https://local.invalid').pathname);
+    return /\.(mp4|m4v|mov|webm|mkv|avi|ts|flv)$/i.test(path) || /^\/media\/[a-f0-9]{32}\/stream\//.test(path);
+  } catch {return false}
+}
