+/** Native reverse-proxy mount; Next links/router already apply basePath themselves. */
+export function appPath(value: string): string {
+  const base = process.env.NEXT_PUBLIC_BASE_PATH || '';
+  if (!value.startsWith('/') || value.startsWith('//') || value === base || value.startsWith(base + '/')) return value;
+  return base + value;
+}
+
+export function cmsUrl(base: string, params: Record<string, string | number>): string {
+  const url = new URL(base);
+  for (const [key,value] of Object.entries(params)) url.searchParams.set(key,String(value));
+  return url.toString();
+}
