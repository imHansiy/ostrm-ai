+import { getEnvSources } from './env-sources';
+import { parseSearchList } from './cms-parser';
+import { cmsUrl } from './app-path';
+import type { SearchResultItem } from './types';
+
+export interface LibraryItem extends SearchResultItem { summary: string; tags: string[] }
+export interface LibraryPage {
+  items: LibraryItem[]; total: number; page: number; pages: number;
+  categories: { id: string; name: string }[]; content: 'general'|'adult';
+}
+type Entry={value:LibraryPage;expires:number};
+const cache=new Map<string,Entry>();
+const pending=new Map<string,Promise<LibraryPage>>();
+export function libraryQuery(params:URLSearchParams) {
+  const content=params.get('content')==='adult'?'adult':'general';
+  const raw=Number(params.get('page')||1);
+  const page=Number.isInteger(raw)&&raw>0?Math.min(raw,100000):1;
+  return {content,page,q:(params.get('q')||'').trim().slice(0,100),category:(params.get('category')||'').slice(0,50)} as const;
+}
+export async function readLibrary(params:URLSearchParams):Promise<LibraryPage> {
+  const query=libraryQuery(params);
+  const source=getEnvSources().find(s=>Boolean(s.isAdult)===(query.content==='adult'));
+  if (!source) throw new Error('尚未配置此内容源');
+  const key=JSON.stringify([source.url,query]);
+  const cached=cache.get(key);
+  if (cached && cached.expires>Date.now()) return cached.value;
+  if(pending.has(key)) return pending.get(key)!;
+  const load=(async()=>{
+    const url=cmsUrl(source.url,{ac:'videolist',pg:query.page,limit:24,wd:query.q,...(query.category?{t:query.category}:{})});
+    // Sources are administrator-defined env values; users never supply a fetch URL.
+    const response=await fetch(url,{signal:AbortSignal.timeout(20000),cache:'no-store'});
+    if(!response.ok)throw new Error('媒体源暂时无法访问');
+    const data=await response.json();
+    if(data.code!==1 || !Array.isArray(data.list))throw new Error('媒体源返回了无效数据');
+    const clean=(s:unknown)=>String(s||'').replace(/<[^>]*>/g,'').trim();
+    const parsed=parseSearchList(data,source);
+    const value:LibraryPage={content:query.content,page:Number(data.page)||query.page,
+      pages:Math.max(1,Number(data.pagecount)||1),total:Math.max(0,Number(data.total)||0),
+      categories:Array.isArray(data.class)?data.class.map((c:Record<string,unknown>)=>({id:String(c.type_id),name:clean(c.type_name)})):[],
+      items:parsed.map((item,i)=>({...item,summary:clean(data.list[i].vod_content),
+        tags:clean(data.list[i].vod_tag||data.list[i].vod_class).split(/[,，、]/).filter(Boolean).slice(0,6)}))};
+    if(cache.size>=80)cache.delete(cache.keys().next().value!);
+    cache.set(key,{value,expires:Date.now()+15000});return value;
+  })();
+  pending.set(key,load);
+  try{return await load}finally{pending.delete(key)}
+}
